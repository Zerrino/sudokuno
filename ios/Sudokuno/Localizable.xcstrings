    "Un des chiffres de ce bloc est faux.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the numbers in this box is wrong."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
