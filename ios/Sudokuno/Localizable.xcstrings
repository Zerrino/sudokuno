          }
        }
      }
    },
    "L'achat n'a pas pu aboutir. Aucun montant n'a été débité.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase couldn't be completed. You haven't been charged."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop kon niet worden voltooid. Er is niets afgeschreven."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra não foi concluída. Não foi cobrado nenhum valor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买未能完成，未扣除任何费用。"
          }
        }
      }
    },
    "L'hypothèse est donc fausse : %1$@ ne contient pas le %2$@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the assumption is false: %1$@ does not hold %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanname is dus onjuist: %1$@ bevat geen %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A hipótese é portanto falsa: %1$@ não contém o %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所以假设不成立：%1$@ 不是 %2$@。"
          }
        }
      }
    },
    "La case %1$@ n'a plus qu'un candidat : le %2$@. Tous les autres chiffres sont déjà dans sa ligne, sa colonne ou son bloc.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cell %1$@ has only one candidate left: %2$@. Every other number is already in its row, column or box."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakje %1$@ heeft nog maar één kandidaat: de %2$@. Alle andere cijfers staan al in zijn rij, kolom of blok."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa %1$@ só tem um candidato: o %2$@. Todos os outros números já estão na sua linha, coluna ou bloco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子 %1$@ 只剩一个候选数：%2$@。其他数字都已出现在它所在的行、列或宫中。"
          }
        }
      }
    },
    "La « grille la plus difficile du monde » qui a fait le tour de la presse en juin 2012.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The \"world's hardest sudoku\" that made headlines around the world in June 2012."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De \"moeilijkste sudoku ter wereld\" die in juni 2012 wereldwijd het nieuws haalde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O \"sudoku mais difícil do mundo\" que fez manchetes em junho de 2012."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 年 6 月登上各大媒体的“世界最难数独”。"
          }
        }
      }
    },
