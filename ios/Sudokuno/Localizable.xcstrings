    "Une des grilles « insolubles » de SudokuWiki : aucune technique logique classique n'en vient à bout.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of SudokuWiki's \"unsolvable\" puzzles: no classic logical technique can crack it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een van de \"onoplosbare\" puzzels van SudokuWiki: geen klassieke logische techniek kraakt hem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dos puzzles \"insolúveis\" do SudokuWiki: nenhuma técnica lógica clássica o resolve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SudokuWiki 的“无解”数独之一：任何经典逻辑技巧都无法解开。"
          }
        }
      }
    },
    "Une notification locale si le Sudoku du jour n'est pas encore fait. Rien n'est envoyé sur Internet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local notification if the Daily Sudoku isn't done yet. Nothing is sent over the internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lokale melding als de Sudoku van de dag nog niet gedaan is. Er wordt niets via internet verstuurd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação local se o Sudoku do dia ainda não estiver feito. Nada é enviado pela Internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若今日数独尚未完成，将发送本地通知。不会通过互联网发送任何数据。"
          }
        }
      }
    },
    "Utilise au moins 8 chiffres différents : avec moins, il y a forcément plusieurs solutions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 8 different numbers: with fewer, there are always several solutions."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik minstens 8 verschillende cijfers: met minder zijn er altijd meerdere oplossingen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa pelo menos 8 números diferentes: com menos, há sempre várias soluções."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少使用 8 个不同的数字：少于 8 个必然有多个解。"
          }
        }
      }
