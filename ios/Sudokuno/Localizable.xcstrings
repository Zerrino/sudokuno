{
  "sourceLanguage": "fr",
  "strings": {
    "%1$@ = %2$@ : c'est la seule place du %2$@ dans %3$@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@: it is the only place for %2$@ in %3$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@: dat is de enige plaats voor de %2$@ in %3$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@: é o único lugar do %2$@ em %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@：这是%3$@中 %2$@ 唯一能填的位置。"
          }
        }
      }
    },
    "%1$@ = %2$@ : c'est son seul candidat restant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@: it is its only remaining candidate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@: dat is de enige overgebleven kandidaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@: é o único candidato que resta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@：这是它唯一剩下的候选数。"
          }
        }
      }
    },
    "%1$@ ne peut pas contenir le %2$@ : cela mènerait aussi à une contradiction (preuve imbriquée, %3$@ coups).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cannot hold %2$@: that would also lead to a contradiction (nested proof, %3$@ moves)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan geen %2$@ bevatten: ook dat zou tot een tegenspraak leiden (genest bewijs, %3$@ zetten)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não pode conter o %2$@: isso também levaria a uma contradição (prova encaixada, %3$@ jogadas)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不可能是 %2$@：那同样会导致矛盾（嵌套证明，%3$@ 步）。"
          }
        }
      }
    },
    "%1$@ ne peut pas contenir le %2$@. En effet, si c'était le cas :": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cannot hold %2$@. Indeed, if it did:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan geen %2$@ bevatten. Want als dat zo was:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não pode conter o %2$@. De facto, se assim fosse:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不可能是 %2$@。因为如果是的话："
          }
        }
      }
    },
