          "stringUnit": {
            "state": "translated",
            "value": "Apagas a casa %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你清空了格子 %@。"
          }
        }
      }
    },
    "Tu gagnes un gel tous les %1$lld jours de série (%2$lld au maximum). Un gel protège ta série si tu oublies un jour.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You earn a freeze every %1$lld days of streak (%2$lld max). A freeze protects your streak if you miss a day."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Je verdient een bevriezing per %1$lld dagen reeks (maximaal %2$lld). Een bevriezing beschermt je reeks als je een dag mist."
                }
              }
            }
          }
        },
        "pt-PT": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ganhas um congelamento a cada %1$lld dias de série (%2$lld no máximo). Um congelamento protege a tua série se falhares um dia."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "每连胜 %1$lld 天可获得一次冻结（最多 %2$lld 次）。忘记一天时，冻结可以保护你的连胜。"
                }
              }
            }
          }
        }
      }
    },
    "Tu la retrouves dans Mes grilles. Tu peux en créer une nouvelle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll find it in My puzzles. You can create a new one."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vindt hem terug in Mijn puzzels. Je kunt een nieuwe maken."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra-lo em Os meus puzzles. Podes criar um novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在“我的数独”中找到它。现在可以创建新的了。"
          }
        }
      }
    },
    "Tu places le %1$@ en %2$@ : ce n'est pas le bon chiffre.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You place %1$@ in %2$@: that is not the right number."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je plaatst de %1$@ in %2$@: dat is niet het juiste cijfer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocas o %1$@ em %2$@: não é o número certo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %2$@ 填入 %1$@：这不是正确的数字。"
          }
        }
      }
    },
