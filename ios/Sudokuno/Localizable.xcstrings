    "Jugée la plus difficile par les chercheurs Ercsey-Ravasz et Toroczkai, qui mesurent la difficulté comme du chaos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rated the hardest by researchers Ercsey-Ravasz and Toroczkai, who measure difficulty as chaos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgens onderzoekers Ercsey-Ravasz en Toroczkai, die moeilijkheid als chaos meten, de allermoeilijkste."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Considerado o mais difícil pelos investigadores Ercsey-Ravasz e Toroczkai, que medem a dificuldade como caos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "研究者 Ercsey-Ravasz 和 Toroczkai 以混沌度衡量难度，认为它是最难的。"
          }
        }
      }
    },
    "L%1$@C%2$@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
